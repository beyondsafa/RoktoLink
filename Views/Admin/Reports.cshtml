@model IEnumerable<RoktoLink.Models.BloodRequest>

@{
    ViewData["Title"] = "System Reports";
}

<h2 class="mb-4">System Reports</h2>

<!-- Nav tabs -->
<ul class="nav nav-tabs mb-4" id="reportTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="activity-tab" data-bs-toggle="tab" data-bs-target="#activity" type="button" role="tab" aria-controls="activity" aria-selected="true">Donation Activity</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="availability-tab" data-bs-toggle="tab" data-bs-target="#availability" type="button" role="tab" aria-controls="availability" aria-selected="false">Blood Type Availability</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="fulfillment-tab" data-bs-toggle="tab" data-bs-target="#fulfillment" type="button" role="tab" aria-controls="fulfillment" aria-selected="false">Fulfillment Log</button>
    </li>
</ul>

<!-- Tab panes -->
<div class="tab-content">
    <div class="tab-pane fade show active" id="activity" role="tabpanel" aria-labelledby="activity-tab">
        <div class="card shadow-sm">
            <div class="card-body">
                <canvas id="activityChart" height="100"></canvas>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="availability" role="tabpanel" aria-labelledby="availability-tab">
        <div class="card shadow-sm">
            <div class="card-body d-flex justify-content-center">
                <div style="width: 50%;">
                    <canvas id="availabilityChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="fulfillment" role="tabpanel" aria-labelledby="fulfillment-tab">
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <form method="get" class="row g-3 align-items-end">
                    <input type="hidden" name="tab" value="fulfillment" />
                    <div class="col-md-3">
                        <label class="form-label">Start Date</label>
                        <input type="date" name="startDate" class="form-control" value="@ViewBag.StartDate" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">End Date</label>
                        <input type="date" name="endDate" class="form-control" value="@ViewBag.EndDate" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Blood Type</label>
                        <select name="bloodType" class="form-select">
                            <option value="">All</option>
                            <option value="A+" selected="@(ViewBag.FilterBloodType == "A+")">A+</option>
                            <option value="A-" selected="@(ViewBag.FilterBloodType == "A-")">A-</option>
                            <option value="B+" selected="@(ViewBag.FilterBloodType == "B+")">B+</option>
                            <option value="B-" selected="@(ViewBag.FilterBloodType == "B-")">B-</option>
                            <option value="AB+" selected="@(ViewBag.FilterBloodType == "AB+")">AB+</option>
                            <option value="AB-" selected="@(ViewBag.FilterBloodType == "AB-")">AB-</option>
                            <option value="O+" selected="@(ViewBag.FilterBloodType == "O+")">O+</option>
                            <option value="O-" selected="@(ViewBag.FilterBloodType == "O-")">O-</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary w-100">Filter Log</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="alert alert-info shadow-sm">
            <strong>Average Time-to-Fulfill (for fulfilled requests in view):</strong> @ViewBag.AvgFulfillmentHours hours
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Created</th>
                                <th>Blood Type</th>
                                <th>Units</th>
                                <th>Urgency</th>
                                <th>Status</th>
                                <th>Fulfilled At</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var req in Model)
                                {
                                    <tr>
                                        <td>#@req.Id</td>
                                        <td>@req.CreatedAt.ToShortDateString()</td>
                                        <td><span class="badge bg-danger">@req.BloodType</span></td>
                                        <td>@req.UnitsNeeded</td>
                                        <td>@req.UrgencyLevel</td>
                                        <td>
                                            <span class="badge bg-@(req.Status == RoktoLink.Models.Enums.RequestStatus.Fulfilled ? "success" : req.Status == RoktoLink.Models.Enums.RequestStatus.Cancelled ? "secondary" : "warning text-dark")">
                                                @req.Status
                                            </span>
                                        </td>
                                        <td>@(req.FulfilledAt?.ToShortDateString() ?? "-")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="7" class="text-center">No requests found.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Switch tab based on URL param if present
        const urlParams = new URLSearchParams(window.location.search);
        if(urlParams.get('tab') === 'fulfillment') {
            var triggerEl = document.querySelector('#fulfillment-tab')
            var tab = new bootstrap.Tab(triggerEl)
            tab.show()
        }

        // Activity Chart (Bar)
        const activityCtx = document.getElementById('activityChart').getContext('2d');
        const months = @Html.Raw(ViewBag.MonthsJson);
        const counts = @Html.Raw(ViewBag.DonationCountsJson);
        
        new Chart(activityCtx, {
            type: 'bar',
            data: {
                labels: months,
                datasets: [{
                    label: 'Donations',
                    data: counts,
                    backgroundColor: 'rgba(220, 53, 69, 0.7)',
                    borderColor: 'rgba(220, 53, 69, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                scales: {
                    y: { beginAtZero: true, ticks: { stepSize: 1 } }
                }
            }
        });

        // Availability Chart (Pie)
        const availCtx = document.getElementById('availabilityChart').getContext('2d');
        const btLabels = @Html.Raw(ViewBag.BloodTypeLabelsJson);
        const btCounts = @Html.Raw(ViewBag.BloodTypeCountsJson);
        
        new Chart(availCtx, {
            type: 'pie',
            data: {
                labels: btLabels,
                datasets: [{
                    label: 'Eligible Donors',
                    data: btCounts,
                    backgroundColor: [
                        '#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0',
                        '#9966FF', '#FF9F40', '#8c564b', '#e377c2'
                    ]
                }]
            }
        });
    </script>
}
