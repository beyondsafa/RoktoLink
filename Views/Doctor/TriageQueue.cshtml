@model IEnumerable<RoktoLink.Models.MedicalScreening>

@{
    ViewData["Title"] = "Medical Triage Queue";
    var doctor = ViewBag.DoctorProfile as RoktoLink.Models.DoctorProfile;
}

<div class="py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-danger mb-0"><i class="bi bi-clipboard2-pulse"></i> Doctor Medical Triage Queue</h2>
            <p class="text-muted mb-0">Pre-donation clinical evaluation & contact disclosure authorization</p>
        </div>
        <div>
            @if (doctor != null && doctor.IsBMDCVerified)
            {
                <span class="badge bg-success fs-6 p-2">
                    <i class="bi bi-patch-check-fill me-1"></i> BMDC Verified: @doctor.BMDCRegistrationNumber
                </span>
            }
            else
            {
                <span class="badge bg-warning text-dark fs-6 p-2">
                    <i class="bi bi-hourglass-split me-1"></i> BMDC Verification Pending (Admin Review)
                </span>
            }
        </div>
    </div>

    @if (doctor != null && !doctor.IsBMDCVerified)
    {
        <div class="alert alert-warning border-warning shadow-sm">
            <strong>Notice for Medical Officers:</strong> Your account is registered under BMDC <code>@doctor.BMDCRegistrationNumber</code> (@doctor.MedicalCollege). An administrator must verify your credentials before you can sign off on clinical clearances.
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0">Volunteering Donors Awaiting Clinical Clearance</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Donor Name</th>
                            <th>Blood Group</th>
                            <th>Area</th>
                            <th>Request #</th>
                            <th>Hospital</th>
                            <th>Urgency</th>
                            <th>Screening Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var s in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@s.Donor?.User?.FullName</td>
                                    <td><span class="badge bg-danger">@s.Donor?.BloodType</span></td>
                                    <td>@s.Donor?.District</td>
                                    <td>#@s.RequestId</td>
                                    <td>@s.Request?.Hospital</td>
                                    <td>
                                        <span class="badge @(s.Request?.UrgencyLevel == RoktoLink.Models.Enums.UrgencyLevel.Critical ? "bg-danger" : s.Request?.UrgencyLevel == RoktoLink.Models.Enums.UrgencyLevel.Urgent ? "bg-warning text-dark" : "bg-info text-dark")">
                                            @s.Request?.UrgencyLevel
                                        </span>
                                    </td>
                                    <td>
                                        @if (s.Status == RoktoLink.Models.Enums.ScreeningStatus.Approved)
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Medically Cleared</span>
                                            <small class="d-block text-muted">Dr. @s.Doctor?.User?.FullName</small>
                                        }
                                        else if (s.Status == RoktoLink.Models.Enums.ScreeningStatus.Rejected)
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i> Rejected</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i> Pending Triage</span>
                                        }
                                    </td>
                                    <td>
                                        @if (s.Status == RoktoLink.Models.Enums.ScreeningStatus.Pending)
                                        {
                                            <a asp-action="Screen" asp-route-id="@s.Id" class="btn btn-sm btn-danger @(doctor != null && !doctor.IsBMDCVerified ? "disabled" : "")">
                                                Conduct Triage
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-action="Screen" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">
                                                View Evaluation
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">No donors currently pending medical pre-screening.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
